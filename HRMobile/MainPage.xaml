<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HRMobile.MainPage"
    Title="HRMobile">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="16"
            VerticalOptions="Center">

            <Label
                Text="HRMobile"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                Text="You are not signed in."
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="IdentityLabel"
                Text=""
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="False" />

            <Label
                Text="Identity token claims"
                FontSize="16"
                FontAttributes="Bold"
                IsVisible="False"
                x:Name="ClaimsHeadingLabel" />

            <Label
                x:Name="ClaimsLabel"
                Text=""
                FontSize="13"
                LineBreakMode="WordWrap"
                IsVisible="False" />

            <Button
                x:Name="LoginButton"
                Text="Sign in"
                Clicked="OnLoginClicked" />

            <Button
                x:Name="LogoutButton"
                Text="Sign out"
                Clicked="OnLogoutClicked"
                IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
