<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="bin\Debug\net10.0\AuthServer.exe" arguments="" stdoutLogEnabled="false" hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_HTTPS_PORT" value="7284" />
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
			<environmentVariable name="AUTHSERVER_CERT_PASSWORD" value="YourPfxPassword" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>