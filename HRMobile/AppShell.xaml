<Shell
    x:Class="HRMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:HRMobile.Pages">

    <FlyoutItem Title="Home">
        <ShellContent
            Title="Home"
            Route="home"
            ContentTemplate="{DataTemplate pages:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Employees">
        <ShellContent
            Title="Employees"
            Route="employees"
            ContentTemplate="{DataTemplate pages:Employees}" />
    </FlyoutItem>

</Shell>